<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SPYon" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="colorPrimary">@color/primary</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorControlHighlight">@color/primary</item>

        <item name="materialAlertDialogTheme">@style/MyAlertDialogTheme</item>

    </style>

    <style name="Theme.SPYon" parent="Base.Theme.SPYon" />

    <style name="MyAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:backgroundTint">@color/background</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorControlNormal">@color/text</item>
        <item name="android:textColorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:colorControlHighlight">@color/primary</item>
    </style>


</resources>
